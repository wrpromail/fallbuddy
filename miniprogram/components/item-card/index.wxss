.item {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 18rpx 20rpx;
  border-radius: 22rpx;
  background: #fafbff;
  border: 2rpx solid transparent;
}

.item--selected {
  border-color: #ff9f43;
  background: #fff8f1;
}

.item--disabled {
  opacity: 0.45;
}

.item__icon {
  width: 76rpx;
  height: 76rpx;
  border-radius: 20rpx;
  background: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
  box-shadow: inset 0 0 0 1rpx #eef1f8;
}

.item__image {
  width: 60rpx;
  height: 60rpx;
}

.item__emoji {
  font-size: 40rpx;
}

.item__main {
  flex: 1;
  min-width: 0;
}

.item__name {
  font-size: 26rpx;
  font-weight: 600;
}

.item__meta {
  font-size: 21rpx;
  color: #8a869f;
}

.item__qty {
  font-size: 24rpx;
  font-weight: 700;
  color: #2f6fe0;
}

.item__check {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background: #ff9f43;
  color: #fff;
  font-size: 22rpx;
  line-height: 36rpx;
  text-align: center;
}
