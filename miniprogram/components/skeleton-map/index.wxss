.map {
  position: relative;
  width: 100%;
  height: 100%;
}

.map__figure {
  position: absolute;
  z-index: 0;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
}

.spot {
  position: absolute;
  width: 72rpx;
  height: 72rpx;
  margin-left: -36rpx;
  margin-top: -36rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  z-index: 9;
}

.spot:active .chip {
  transform: scale(0.92);
}

.spot__sticker {
  position: absolute;
  right: -8rpx;
  top: -10rpx;
  width: 34rpx;
  height: 34rpx;
  line-height: 34rpx;
  text-align: center;
  font-size: 20rpx;
  border-radius: 50%;
  background: #ffffff;
  box-shadow: 0 4rpx 10rpx rgba(43, 35, 64, 0.18);
  z-index: 10;
  pointer-events: none;
}

.dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  border: 2rpx dashed rgba(43, 35, 64, 0.28);
  background: rgba(255, 255, 255, 0.5);
}

.stack {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
}

.chip {
  width: 54rpx;
  height: 54rpx;
  padding: 2rpx;
  border-radius: 50%;
  border: 3rpx solid transparent;
  background: #fff;
  box-shadow: 0 4rpx 12rpx rgba(43, 35, 64, 0.16);
  overflow: hidden;
  transition: transform 120ms ease-out;
}

.chip + .chip {
  margin-left: -8rpx;
}

.chip--more {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 19rpx;
  font-weight: 700;
  color: #ffffff;
  background: #2b2340;
  border-color: #2b2340;
}

.map--standard .spot {
  width: 52rpx;
  height: 52rpx;
  margin-left: -26rpx;
  margin-top: -26rpx;
}

.spot__count,
.spot--selected .dot {
  box-sizing: border-box;
  border: 2rpx solid #fff;
  background: #2358b3;
  color: #fff;
}

.spot__count {
  display: grid;
  place-items: center;
  min-width: 30rpx;
  height: 30rpx;
  padding: 0 4rpx;
  border-radius: 24rpx;
  font-weight: 600;
  font-size: 18rpx;
}

.spot--selected .dot {
  width: 27rpx;
  height: 27rpx;
}
