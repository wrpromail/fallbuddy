<view class="map {{plate ? 'map--standard' : ''}}">
  <image wx:if="{{plate}}" class="map__figure" src="{{plate}}" mode="scaleToFill"
    aria-label="{{appearanceMode === 'bones' ? '成人骨骼图' : '成人浅层肌肉图'}}" />
  <avatar-rig
    wx:else
    class="map__figure"
    view="{{view}}"
    mode="full"
    palette="{{figPalette}}"
    head-shape="{{figHeadShape}}"
    expression="{{figExpression}}"
    equipped="{{figEquipped}}"
    reduce-motion="{{reduceMotion}}"
  />
  <block wx:if="{{showMarkers}}">
  <view
    wx:for="{{spots}}"
    wx:key="id"
    class="spot {{item.count ? 'spot--active' : ''}} {{item.selected ? 'spot--selected' : ''}}"
    style="left:{{item.left}}%;top:{{item.top}}%"
    data-id="{{item.id}}"
    data-label="{{item.label}}"
    bindtap="onTap"
    aria-role="button"
    aria-label="{{item.label}}（{{item.count}} 条故事）"
  >
    <view wx:if="{{item.sticker && !plate}}" class="spot__sticker">{{item.sticker}}</view>
    <view wx:if="{{plate && item.count}}" class="spot__count">{{item.count}}</view>
    <view wx:elif="{{item.chips.length}}" class="stack">
      <view
        wx:for="{{item.chips}}"
        wx:for-item="chip"
        wx:key="userId"
        class="chip"
        style="background:{{chip.bg}};border-color:{{chip.border}}"
      >
        <avatar-rig
          mode="chip"
          view="{{view}}"
          palette="{{chip.palette}}"
          head-shape="{{chip.headShape}}"
          expression="{{chip.expression}}"
          equipped="{{chip.equipped}}"
        />
      </view>
      <view wx:if="{{item.more}}" class="chip chip--more">+{{item.more}}</view>
    </view>
    <view wx:else class="dot"></view>
  </view>
  </block>
</view>
