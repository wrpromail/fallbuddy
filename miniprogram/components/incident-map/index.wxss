.incident-map {
  margin-top: 16rpx;
}

.incident-map__controls {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 12rpx;
}

.incident-map__controls .btn {
  margin: 0;
  padding: 0 14rpx;
  font-size: 24rpx;
  min-height: 54rpx;
}

.incident-map__figure {
  position: relative;
  width: 440rpx;
  height: 660rpx;
  margin: 0 auto;
  background: #f3f6fb;
  border-radius: 16rpx;
}
