<view class="page">
  <view class="head">
    <view>
      <view class="head__title">我的角色</view>
      <view class="head__sub">换装、表情和配色都会同步到图鉴小头像</view>
    </view>
    <view class="icon-btn" bindtap="onSettings">⚙</view>
  </view>

  <view wx:if="{{loading && !avatar}}" class="panel card">正在加载角色…</view>
  <view wx:if="{{error}}" class="panel card">
    <view>{{error}}</view>
    <button class="btn btn--ghost" bindtap="load">重试</button>
  </view>

  <block wx:if="{{preview}}">
    <view class="stage card {{draft ? 'stage--editing' : ''}}">
      <view class="character-controls">
        <button class="btn {{view === 'front' && mode === 'full' ? 'btn--primary' : 'btn--ghost'}}" data-id="front" bindtap="onPreview">正面</button>
        <button class="btn {{view === 'back' ? 'btn--primary' : 'btn--ghost'}}" data-id="back" bindtap="onPreview">背面</button>
        <button class="btn {{mode === 'chip' ? 'btn--primary' : 'btn--ghost'}}" data-id="chip" bindtap="onPreview">小头像</button>
      </view>
      <view class="stage__figure {{mode === 'chip' ? 'stage__figure--chip' : ''}}">
        <avatar-rig id="avatar-preview" view="{{view}}" mode="{{mode}}" palette="{{preview.palette}}"
          head-shape="{{preview.headShape}}" expression="{{preview.expression}}" equipped="{{preview.equipped}}" carry-hand="{{preview.carryHand}}" reduce-motion="{{reduceMotion}}" />
      </view>
      <view wx:if="{{draft}}" class="character-controls">
        <button wx:for="{{actions}}" wx:key="id" class="btn btn--ghost" data-id="{{item.id}}" bindtap="onPreviewAction">{{item.label}}</button>
      </view>
      <button wx:else class="btn btn--primary" bindtap="onEdit">{{avatar.customized === false ? '创建我的角色' : '编辑形象与穿搭'}}</button>
      <view wx:if="{{notice && !draft}}" class="tiny muted">{{notice}}</view>
    </view>

    <view wx:if="{{!draft && outfits.length}}" class="panel card">
      <view class="section-title">我的穿搭收藏</view>
      <view wx:for="{{outfits}}" wx:key="slot" class="character-controls">
        <text>穿搭 {{item.slot}}</text>
        <button wx:if="{{item.appearance}}" class="btn" disabled="{{saving}}" data-slot="{{item.slot}}" bindtap="onTryOutfit">试穿</button>
        <button class="btn btn--ghost" disabled="{{saving}}" data-slot="{{item.slot}}" bindtap="onStoreOutfit">{{item.appearance ? '用当前形象替换' : '收藏当前形象'}}</button>
        <button wx:if="{{item.appearance}}" class="btn btn--ghost" disabled="{{saving}}" data-slot="{{item.slot}}" data-clear="yes" bindtap="onStoreOutfit">移除</button>
      </view>
    </view>
    <block wx:if="{{draft}}">
      <button class="btn btn--ghost" disabled="{{saving}}" bindtap="onRandomOutfit">随机试穿已拥有的装备</button>
      <view class="panel card">
        <view class="section-title">头型</view>
        <view class="character-controls character-controls--left">
          <button wx:for="{{headShapes}}" wx:key="id" class="btn {{draft.headShape === item.id ? 'btn--primary' : 'btn--ghost'}}"
            data-id="{{item.id}}" bindtap="onShape">{{item.label}}</button>
        </view>
        <view class="section-title">表情</view>
        <view class="character-controls character-controls--left">
          <button wx:for="{{expressions}}" wx:key="id" class="btn {{draft.expression === item.id ? 'btn--primary' : 'btn--ghost'}}"
            data-id="{{item.id}}" bindtap="onExpression">{{item.label}}</button>
        </view>
        <view class="section-title">角色主色</view>
        <view class="character-controls character-controls--left">
          <button wx:for="{{palettes}}" wx:key="id" class="btn {{draft.palette === item.id ? 'btn--primary' : 'btn--ghost'}}"
            data-id="{{item.id}}" bindtap="onPalette"><text class="color-dot" style="background:{{item.color}}"></text>{{item.label}}</button>
        </view>
      </view>

      <view class="panel card">
        <view class="section-title">衣橱</view>
        <view class="character-controls character-controls--left">
          <button wx:for="{{slots}}" wx:key="id" class="btn {{slot === item.id ? 'btn--primary' : 'btn--ghost'}}"
            data-id="{{item.id}}" bindtap="onSlot">{{item.label}}</button>
        </view>
        <button class="btn btn--ghost" data-id="" disabled="{{!selectedItem || saving}}" bindtap="onTryGear">{{slot === 'handheld' ? '放下手持装备' : '脱下这个部位的装备'}}</button>
        <view wx:if="{{snowboardSelected}}" class="character-controls character-controls--left">
          <button class="btn {{draft.carryHand === 'left' ? 'btn--primary' : 'btn--ghost'}}"
            data-id="left" bindtap="onCarryHand" disabled="{{saving}}">左手持板</button>
          <button class="btn {{draft.carryHand !== 'left' ? 'btn--primary' : 'btn--ghost'}}"
            data-id="right" bindtap="onCarryHand" disabled="{{saving}}">右手持板</button>
        </view>
        <view wx:if="{{slot === 'handheld' && selectedItem}}" class="tiny muted">抱抱和鼓掌时会暂时收好器材，动作结束后自动拿回。</view>
        <view wx:for="{{wardrobe}}" wx:key="id" class="wardrobe-item">
          <image class="wardrobe-item__image" src="{{item.src}}" mode="aspectFit" />
          <view class="wardrobe-item__text">
            <view>{{item.name}}</view>
            <view class="tiny muted">{{item.desc}}</view>
            <view class="tiny muted">{{selectedItem === item.id ? (selectedOwned ? '已选用' : '预览中') : (avatar.equipped[slot] === item.id ? '已保存' : (item.owned ? '已拥有' : '可免费领取'))}}</view>
          </view>
          <view class="wardrobe-item__actions">
            <button class="btn btn--ghost" disabled="{{saving || selectedItem === item.id}}" data-id="{{item.id}}" bindtap="onTryGear">{{slot === 'handheld' ? '试拿' : '试穿'}}</button>
            <button wx:if="{{!item.owned}}" class="btn btn--ghost" disabled="{{claimingItem || saving}}" data-id="{{item.id}}" bindtap="onClaimGear">免费领取</button>
          </view>
        </view>
      </view>

      <view class="editor-footer">
        <view wx:if="{{notice}}" class="editor-footer__notice" aria-role="status">{{notice}}</view>
        <view class="character-controls">
          <button class="btn btn--ghost" disabled="{{saving || claimingItem}}" bindtap="onCancel">取消</button>
          <button class="btn btn--primary" disabled="{{saving || claimingItem || loading}}" bindtap="onSave">{{saving ? '保存中…' : '保存角色'}}</button>
        </view>
      </view>
    </block>
  </block>

  <view class="panel card">
    <view class="panel__head">
      <view class="section-title">背包</view>
      <view class="tiny muted">{{weeklyClaimed ? '本周补给已领取' : '本周补给待领取'}}</view>
    </view>
    <view class="weekly">
      <view class="weekly__text">
        <view class="weekly__title">每周免费补给</view>
        <view class="tiny muted">2 件随机互动道具 · 不需要分享，也没有现金价值</view>
      </view>
      <view
        class="btn {{weeklyClaimed ? 'btn--ghost' : 'btn--primary'}}"
        bindtap="onClaimWeekly"
      >{{claiming ? '领取中…' : weeklyClaimed ? '已领取' : '领取'}}</view>
    </view>
    <view wx:if="{{pollBadge}}" class="pill pill--accent">🏅 圈内故事评选参与纪念章</view>
    <view class="items">
      <view wx:for="{{inventory}}" wx:key="itemDefId">
        <item-card item="{{item}}" />
        <button wx:if="{{item.category === 'consumable'}}" class="btn btn--ghost" data-id="{{item.itemDefId}}" bindtap="onConsume">使用一件</button>
      </view>
    </view>
  </view>

  <view class="stories">
    <view class="between">
      <view class="section-title">我的经历</view>
      <view class="tiny muted">{{myStories.length}} 条</view>
    </view>
    <view class="between">
      <button class="btn" bindtap="onNewStory">新建事故记录</button>
      <button wx:if="{{hasDraft}}" class="btn" bindtap="onResumeDraft">继续写私人草稿</button>
    </view>
    <view class="stories__list">
      <story-card wx:for="{{myStories}}" wx:key="id" story="{{item}}" bind:select="onSelectStory" />
      <view wx:if="{{!myStories.length}}" class="empty card">
        <view class="empty__emoji">🫥</view>
        <view class="empty__title">还没有故事</view>
        <view class="btn btn--primary" bindtap="onNewStory">记录第一条</view>
      </view>
    </view>
  </view>

  <view class="footnote">角色资产为原创几何造型；不包含任何品牌 Logo 或官方联名暗示。</view>
</view>
