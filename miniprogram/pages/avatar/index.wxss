.page {
  min-height: 100vh;
  padding: 20rpx 28rpx 140rpx;
  background:
    radial-gradient(110% 45% at 95% 0%, rgba(255, 176, 120, 0.18), rgba(242, 246, 255, 0) 60%),
    radial-gradient(90% 40% at 0% 6%, rgba(120, 170, 255, 0.2), rgba(242, 246, 255, 0) 55%),
    #f2f6ff;
}

.head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
  padding: 8rpx 4rpx 0;
}

.head__title {
  font-size: 44rpx;
  font-weight: 800;
  letter-spacing: -0.5rpx;
}

.head__sub {
  margin-top: 6rpx;
  font-size: 23rpx;
  color: #7a7790;
}

.icon-btn {
  width: 68rpx;
  height: 68rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.85);
  box-shadow: 0 8rpx 20rpx rgba(43, 35, 64, 0.08);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  color: #4a4466;
  flex: none;
}

.stage {
  margin-top: 20rpx;
  padding: 10rpx 16rpx 20rpx;
  border-radius: 34rpx;
  text-align: center;
  background: radial-gradient(ellipse at center, #ffffff 0%, #e4eeff 100%);
}

.stage--editing {
  position: sticky;
  top: 0;
  z-index: 4;
}

.stage__figure {
  position: relative;
  width: 320rpx;
  height: 480rpx;
  margin: 0 auto;
}

.stage--editing .stage__figure {
  width: 180rpx;
  height: 270rpx;
}

.stage--editing .stage__figure--chip {
  width: 160rpx;
  height: 160rpx;
}

.panel {
  margin-top: 18rpx;
  padding: 26rpx;
}

.panel__head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 18rpx;
}

.weekly {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  padding: 20rpx 22rpx;
  border-radius: 20rpx;
  background: linear-gradient(120deg, rgba(255, 138, 61, 0.1), rgba(76, 141, 255, 0.08));
}

.weekly__text {
  flex: 1;
  min-width: 0;
}

.weekly__title {
  font-size: 26rpx;
  font-weight: 700;
}

.items {
  margin-top: 16rpx;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.stories {
  margin-top: 28rpx;
}

.stories__list {
  margin-top: 14rpx;
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.empty {
  padding: 48rpx 30rpx;
  text-align: center;
}

.empty__emoji {
  font-size: 60rpx;
}

.empty__title {
  margin: 10rpx 0 18rpx;
  font-size: 30rpx;
  font-weight: 700;
}

.footnote {
  margin: 28rpx 10rpx 0;
  font-size: 21rpx;
  line-height: 1.6;
  color: #9a96ae;
  text-align: center;
}

.stage__figure--chip {
  width: 240rpx;
  height: 240rpx;
  margin: 16rpx auto;
}

.character-controls {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 10rpx;
  margin: 14rpx 0 22rpx;
}

.character-controls--left {
  justify-content: flex-start;
}

.character-controls .btn,
.wardrobe-item .btn {
  width: auto;
  margin: 0;
  padding: 10rpx 16rpx;
  min-height: 62rpx;
  font-size: 24rpx;
}

.color-dot {
  display: inline-block;
  width: 22rpx;
  height: 22rpx;
  border: 2rpx solid #fff;
  border-radius: 50%;
  margin-right: 8rpx;
}

.wardrobe-item {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 14rpx;
  padding: 12rpx 0;
  border-bottom: 1px solid #eef2f8;
}

.wardrobe-item__image {
  flex: none;
  width: 72rpx;
  height: 72rpx;
}

.wardrobe-item__text {
  flex: 1;
  min-width: 0;
}

.wardrobe-item__actions {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.editor-footer {
  position: sticky;
  bottom: 0;
  padding: 6rpx 12rpx;
  background: #f2f6ff;
  z-index: 5;
}

.editor-footer__notice {
  padding: 10rpx 14rpx;
  color: #384561;
  font-size: 24rpx;
  text-align: center;
}
