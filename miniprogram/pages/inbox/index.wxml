<view class="page">
  <view class="head">
    <view class="head__title">消息</view>
    <button wx:if="{{unreadCount}}" class="btn btn--ghost mark" bindtap="onMarkAllRead">全部已读</button>
  </view>

  <view wx:if="{{loading}}" class="loading">正在收消息…</view>
  <view wx:elif="{{error}}" class="empty card">
    <view class="empty__title">{{error}}</view>
  </view>

  <block wx:else>
    <navigator wx:for="{{updates}}" wx:key="id" class="card event" url="/pages/story/detail?groupId={{item.groupId}}&amp;storyId={{item.storyId}}">关注的《{{item.title}}》有了后续 · {{item.body}}</navigator>
    <navigator wx:for="{{requests}}" wx:key="id" class="card event" url="/pages/links/index?groupId={{item.groupId}}&amp;storyId={{item.storyId}}">《{{item.title}}》申请关联你的《{{item.targetTitle}}》 · 查看</navigator>
    <view wx:if="{{!groups.length && !requests.length && !updates.length}}" class="empty card">
      <view class="empty__title">暂无互动消息</view>
      <button class="btn btn--primary" bindtap="goAtlas">去图鉴看看</button>
    </view>

    <view wx:else class="feed">
      <view wx:for="{{groups}}" wx:key="id" class="card">
        <view class="event {{item.unreadCount ? '' : 'event--read'}}" data-id="{{item.id}}" bindtap="onToggleGroup"
          aria-role="button" aria-label="{{item.storyTitle}}，{{item.summary}}">
          <view class="event__emoji">{{item.emoji}}</view>
          <view class="event__main">
            <view class="event__text">{{item.storyTitle}}</view>
            <view class="event__time">{{item.summary}} · {{item.timeText}}</view>
          </view>
          <view wx:if="{{item.unreadCount}}" class="event__dot"></view>
          <text class="tiny">{{openGroupId === item.id ? '收起' : '展开'}}</text>
        </view>
        <view wx:if="{{openGroupId === item.id}}" class="event-details">
          <view wx:for="{{item.events}}" wx:for-item="event" wx:key="id" class="event-details__row">
            <view class="event-details__main">
              <view>{{event.actorName}}</view>
              <view class="event__time">{{event.itemName ? event.itemName + ' · ' : ''}}{{event.timeText}}</view>
            </view>
            <button class="btn btn--ghost" data-story="{{event.storyId}}" data-id="{{event.id}}" bindtap="onReplay">回放</button>
            <button class="btn btn--ghost" data-id="{{event.actorId}}" data-name="{{event.actorName}}" bindtap="onBlock">屏蔽</button>
          </view>
          <button class="btn btn--ghost" data-id="{{item.id}}" bindtap="onIgnore">忽略这一组</button>
        </view>
      </view>
      <view wx:if="{{nextCursor}}" class="more" bindtap="onLoadMore">{{loadingMore ? '加载中…' : '加载更多'}}</view>
    </view>
  </block>
</view>
