.page {
  min-height: 100vh;
  padding: 20rpx 28rpx 140rpx;
  background:
    radial-gradient(120% 45% at 0% 0%, rgba(120, 170, 255, 0.2), rgba(242, 246, 255, 0) 58%),
    #f2f6ff;
}

.head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
  padding: 8rpx 4rpx 0;
}

.head__title {
  font-size: 44rpx;
  font-weight: 800;
  letter-spacing: -0.5rpx;
}

.head__sub {
  margin-top: 6rpx;
  font-size: 23rpx;
  color: #7a7790;
}

.mark {
  height: 60rpx;
  padding: 0 22rpx;
  font-size: 22rpx;
  flex: none;
}

.loading {
  padding: 120rpx 0;
  text-align: center;
  color: #8a869f;
}

.empty {
  margin-top: 30rpx;
  padding: 60rpx 36rpx;
  text-align: center;
}

.empty__emoji {
  font-size: 72rpx;
}

.empty__title {
  margin-top: 12rpx;
  font-size: 32rpx;
  font-weight: 700;
}

.empty__text {
  margin-top: 8rpx;
  font-size: 23rpx;
  line-height: 1.6;
  color: #8a869f;
}

.empty .btn {
  margin-top: 24rpx;
}

.feed {
  margin-top: 22rpx;
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.event {
  position: relative;
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 22rpx 24rpx;
}

.event--read {
  opacity: 0.72;
}

.event__emoji {
  width: 76rpx;
  height: 76rpx;
  border-radius: 22rpx;
  background: #f3f6ff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 38rpx;
  flex: none;
}

.event__main {
  flex: 1;
  min-width: 0;
}

.event__text {
  font-size: 26rpx;
  line-height: 1.5;
  color: #3b3554;
}

.event__actor {
  font-weight: 700;
  color: #2b2340;
  margin-right: 4rpx;
}

.event__time {
  margin-top: 4rpx;
  font-size: 20rpx;
  color: #9a96ae;
}

.event__item {
  width: 60rpx;
  height: 60rpx;
  flex: none;
}

.event__dot {
  position: absolute;
  right: 18rpx;
  top: 18rpx;
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #ff6b6b;
}

.more {
  margin: 12rpx 0;
  text-align: center;
  font-size: 24rpx;
  color: #2f6fe0;
  padding: 18rpx;
}

.footnote {
  margin: 28rpx 10rpx 0;
  font-size: 21rpx;
  line-height: 1.6;
  color: #9a96ae;
  text-align: center;
}
