<view class="page">
  <view wx:if="{{loading}}" class="loading">正在翻开这条故事…</view>

  <view wx:elif="{{error}}" class="empty card">
    <view class="empty__emoji">🫥</view>
    <view class="empty__title">看不了这条故事</view>
    <view class="empty__text">{{error}}</view>
    <view class="btn btn--primary" bindtap="goAtlas">回到图鉴</view>
  </view>

  <block wx:else>
    <view class="topbar">
      <view class="author">
        <view class="author__avatar">
          <avatar-rig
            mode="chip"
            palette="{{detail.avatar.palette}}"
            head-shape="{{detail.avatar.headShape}}"
            expression="{{detail.avatar.expression}}"
            equipped="{{detail.avatar.equipped}}"
          />
        </view>
        <view class="author__main">
          <view class="author__name">
            {{detail.author.displayName}}
            <text wx:if="{{detail.story.isAnonymous}}" class="badge">匿名展示</text>
            <text wx:if="{{detail.story.visibility === 'self'}}" class="badge">仅自己可见</text>
          </view>
          <view class="author__meta">{{groupName}} · {{timeText}} · {{sportEmoji}} {{sportLabel}}</view>
        </view>
      </view>
      <button wx:if="{{detail.story.visibility !== 'self'}}" class="share-btn" open-type="share">↗</button>
    </view>

    <view class="stage {{stageClass}}">
      <view class="stage__badge">{{sportEmoji}} {{sportLabel}}</view>
      <view class="stage__impact">{{impactLabel}}</view>
      <view class="stage__author">
        <avatar-rig
          id="author-rig"
          view="front"
          palette="{{detail.avatar.palette}}"
          head-shape="{{detail.avatar.headShape}}"
          expression="{{detail.avatar.expression}}"
          equipped="{{detail.avatar.equipped}}"
          reduce-motion="{{reduceMotion}}"
        />
      </view>
      <view wx:if="{{stageClass === 'is-hug' && myAvatar}}" class="stage__me">
        <avatar-rig
          view="front"
          palette="{{myAvatar.palette}}"
          head-shape="{{myAvatar.headShape}}"
          expression="{{myAvatar.expression}}"
          equipped="{{myAvatar.equipped}}"
        />
      </view>
      <view wx:if="{{stageEmoji}}" class="stage__fx">{{stageEmoji}}</view>
      <view wx:if="{{animationHint}}" class="stage__hint">{{animationHint}}</view>
    </view>

    <view class="story card">
      <view wx:if="{{detail.story.moderationStatus === 'hidden'}}" class="story__note">此故事已由管理员隐藏</view>
      <view class="story__title">{{detail.story.title}}</view>
      <view class="story__body">{{detail.story.body}}</view>
      <view wx:if="{{detail.incident.happenedOn}}" class="story__note">发生于 {{detail.incident.happenedOn}}</view>
      <view wx:if="{{detail.incident.userSummary && detail.incident.userSummary !== detail.story.body}}" class="story__note">事故自述 · {{detail.incident.userSummary}}</view>
      <view class="tags">
        <text wx:for="{{bodyPartLabels}}" wx:key="*this" class="tag tag--blue">{{item}}</text>
        <text class="tag tag--blue">{{sportLabel}}</text>
        <text class="tag">{{impactLabel}}</text>
        <text wx:for="{{scenarioLabels}}" wx:key="*this" class="tag">{{item}}</text>
        <text wx:for="{{causeLabels}}" wx:key="*this" class="tag tag--warm">自述：{{item}}</text>
        <text wx:for="{{protectiveLabels}}" wx:key="*this" class="tag tag--mint">{{item}}</text>
      </view>
      <incident-map parts="{{detail.incident.bodyParts}}" />
      <view class="story__note">「原因」是本人自述，不是责任认定，也不构成医疗或理赔判断。</view>
      <view wx:if="{{detail.story.visibility === 'self'}}" class="story__note">这条故事仅自己可见，不会出现在圈子图鉴，别人也打不开。</view>
    </view>

    <view wx:if="{{updatesView.length || canEdit}}" class="timeline card">
      <view class="between">
        <view class="section-title">后续</view>
        <button wx:if="{{canEdit}}" class="btn" disabled="{{updateSaving}}" bindtap="onComposeUpdate">
          {{composingUpdate ? '收起' : '追加后续'}}
        </button>
      </view>
      <view wx:if="{{composingUpdate && canEdit}}" class="update-form">
        <picker range="{{updateTypeLabels}}" value="{{updateTypeIndex}}" disabled="{{updateSaving}}" bindchange="onUpdateType">
          <view class="btn">{{updateTypeLabels[updateTypeIndex]}}</view>
        </picker>
        <textarea value="{{updateBody}}" maxlength="140" auto-height disabled="{{updateSaving}}"
          placeholder="写下后来发生的事" bindinput="onUpdateBody" />
        <view class="tiny muted">可见范围继承当前故事 · {{updateBody.length}}/140</view>
        <button class="btn btn--primary" disabled="{{updateSaving || !updateBody.length}}" bindtap="onSaveUpdate">保存后续</button>
      </view>
      <view wx:for="{{updatesView}}" wx:key="id" class="update">
        <view class="update__rail">
          <view class="update__dot"></view>
          <view class="update__line"></view>
        </view>
        <view class="update__main">
          <view class="update__head">
            <text class="update__type">{{item.typeLabel}}</text>
            <text class="update__time">{{item.timeText}}</text>
          </view>
          <view class="update__body">{{item.body}}</view>
          <view wx:if="{{isMine}}" class="link link--danger" data-id="{{item.id}}" bindtap="onWithdrawUpdate">撤回这条后续</view>
        </view>
      </view>
    </view>

    <view class="react card">
      <reaction-bar
        reactions="{{detail.reactions}}"
        my-reactions="{{detail.myReactions}}"
        allow-funny="{{detail.canSpin}}"
        disabled="{{!detail.canInteract}}"
        bind:react="onReact"
        bind:gift="openGift"
      />
      <view class="react__note">每人每天对同一条故事最多互动 3 次（抱抱/转圈/鼓掌合计）；装备免费、无现金价值。作者关闭搞笑动作后，「转圈」会自动禁用。</view>
    </view>

    <view class="links">
      <view wx:if="{{!isMine && detail.group}}" class="link" bindtap="onReport">举报这条内容</view>
      <view wx:if="{{canEdit}}" class="link" bindtap="onEditStory">编辑事故记录</view>
      <view wx:if="{{canEdit}}" class="link link--danger" bindtap="onWithdraw">撤回我的故事</view>
    </view>
  </block>

  <view wx:if="{{showGift}}" class="sheet-mask" bindtap="closeGift"></view>
  <view class="sheet {{showGift ? 'sheet--open' : ''}}" catchtap="noop">
    <view class="sheet__handle"></view>
    <view class="sheet__head">
      <view>
        <view class="section-title">送一件装备</view>
        <view class="tiny muted">送给 {{detail.author.displayName}}，不花一分钱</view>
      </view>
      <view class="tiny muted">每日限 3 件</view>
    </view>
    <scroll-view scroll-y class="sheet__body" style="height:{{giftHeight}}rpx">
      <view class="sheet__list">
        <item-card
          wx:for="{{giftItems}}"
          wx:key="itemDefId"
          item="{{item}}"
          selected="{{selectedItem === item.itemDefId}}"
          bind:select="onSelectItem"
        />
        <view wx:if="{{!giftItems.length}}" class="sheet__empty">背包里还没有可以送出的互动道具。可以在「我的角色」页领取本周免费补给。</view>
      </view>
    </scroll-view>
    <view class="sheet__foot">
      <button class="btn btn--primary sheet__confirm" bindtap="confirmGift">送出去</button>
    </view>
  </view>
</view>
