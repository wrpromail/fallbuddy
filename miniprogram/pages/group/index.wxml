<view class="page">
  <view wx:if="{{!joining && !loading}}" class="panel card">
    <picker wx:if="{{groups.length}}" range="{{groups}}" range-key="name" bindchange="onChooseGroup">
      <view class="btn btn--ghost">切换圈子</view>
    </picker>
    <button class="btn btn--primary" bindtap="onToggleCreate">{{creating ? '收起表单' : '创建圈子'}}</button>
    <block wx:if="{{creating}}">
      <input class="group-name-input" value="{{groupName}}" maxlength="24" placeholder="圈子名称" bindinput="onGroupName" />
      <view class="member">
        <view class="member__main">新成员需要审批</view>
        <switch checked="{{requiresApproval}}" bindchange="onJoinMode" />
      </view>
      <button class="btn btn--primary" disabled="{{createSaving || !groupName}}" bindtap="onCreateGroup">{{createSaving ? '创建中…' : '创建'}}</button>
    </block>
  </view>
  <view wx:if="{{joining}}" class="loading">正在加入圈子…</view>

  <view wx:elif="{{loading}}" class="loading">正在打开圈子…</view>

  <view wx:elif="{{error}}" class="empty card">
    <view class="empty__emoji">🏔️</view>
    <view class="empty__title">{{error}}</view>
  </view>

  <block wx:else>
    <view class="hero card">
      <view class="hero__row">
        <view class="hero__name">{{group.name}}</view>
        <view class="pill pill--blue">{{group.role === 'owner' ? '圈主' : group.role === 'admin' ? '管理员' : '成员'}}</view>
      </view>
      <view class="hero__meta">{{group.memberCount}} 位雪友 · {{group.joinMode === 'open' ? '自由加入' : '需要圈主确认'}}</view>
      <navigator class="btn btn--ghost" url="/pages/poll/index?groupId={{group.id}}">圈内故事评选</navigator>
      <view class="hero__stats">
        <view class="mini">
          <view class="mini__num">{{members.length}}</view>
          <view class="mini__label">成员</view>
        </view>
        <view class="mini">
          <view class="mini__num">{{members[0] ? members[0].storyCount : 0}}</view>
          <view class="mini__label">圈主故事</view>
        </view>
      </view>
    </view>

    <view class="panel card">
      <view class="panel__head">
        <view class="section-title">圈子成员</view>
        <view class="tiny muted">按加入顺序</view>
      </view>
      <view class="members">
        <view wx:for="{{members}}" wx:key="userId" class="member">
          <view class="member__avatar">
            <avatar-rig
              mode="chip"
              palette="{{item.palette}}"
              head-shape="{{item.headShape}}"
              expression="{{item.expression}}"
              equipped="{{item.equipped}}"
            />
          </view>
          <view class="member__main">
            <view class="member__name">
              {{item.displayName}}
              <text wx:if="{{item.isMe}}" class="member__me">我</text>
            </view>
            <view class="member__meta">{{item.storyCount}} 条故事</view>
          </view>
          <view class="member__role">{{item.role === 'owner' ? '圈主' : item.role === 'admin' ? '管理员' : ''}}</view>
          <button wx:if="{{isOwner && !item.isMe}}" class="btn btn--ghost" data-id="{{item.userId}}" bindtap="onTransfer">转让圈主</button>
        </view>
      </view>
    </view>

    <view class="panel card">
      <view class="panel__head">
        <view class="section-title">邀请雪友</view>
        <view class="tiny muted">48 小时有效</view>
      </view>
      <view class="invite">
        <button wx:if="{{canInvite}}" class="btn btn--primary" bindtap="onCreateInvite">
          {{inviteLoading ? '生成中…' : '生成邀请'}}
        </button>
        <view wx:else class="tiny muted">只有圈主或管理员可以生成邀请。</view>
      </view>
      <view wx:if="{{invite}}" class="invite-box">
        <view class="invite-box__label">邀请路径（复制后发给朋友）</view>
        <view class="invite-box__value">{{invite.sharePath}}</view>
        <view class="invite-box__actions">
          <button class="btn btn--ghost" bindtap="onCopyInvite">复制路径</button>
          <button class="btn btn--ghost" open-type="share">直接分享</button>
        </view>
        <view class="invite-box__note">链接只带邀请 token，不带任何账号凭证。对方点击后仍需确认加入。</view>
      </view>
      <view class="invite-note">「圈子」是应用内的受邀群体，不等于微信群全体成员。加入后才能看到圈内故事。</view>
      <view wx:for="{{invites}}" wx:key="id" class="member">
        <view class="member__main">{{item.expires}} 到期 · 已用 {{item.uses}} / {{item.maxUses}}</view>
        <button class="btn btn--ghost" data-id="{{item.id}}" bindtap="onRevokeInvite">撤销</button>
      </view>
    </view>

    <view wx:if="{{joinRequests.length}}" class="panel card">
      <view class="section-title">入圈申请</view>
      <view wx:for="{{joinRequests}}" wx:key="id" class="member">
        <view class="member__main">{{item.displayName}}</view>
        <button class="btn" data-id="{{item.id}}" data-action="deny" bindtap="onReviewMember">拒绝</button>
        <button class="btn btn--primary" data-id="{{item.id}}" data-action="approve" bindtap="onReviewMember">批准</button>
      </view>
    </view>

    <view wx:if="{{reports.length}}" class="panel card">
      <view class="section-title">待处理举报</view>
      <view wx:for="{{reports}}" wx:key="id" class="member">
        <view class="member__main" data-id="{{item.storyId}}" bindtap="onOpenReportedStory">{{item.reasonLabel}} · 查看故事</view>
        <button class="btn" data-id="{{item.id}}" data-action="dismiss" bindtap="onResolveReport">关闭</button>
        <button class="btn btn--primary" data-id="{{item.id}}" data-action="hide" bindtap="onResolveReport">隐藏</button>
      </view>
    </view>

    <view wx:if="{{canInvite}}" class="panel card member">
      <view class="member__main">
        <view class="section-title">暂停圈内互动</view>
        <view class="tiny muted">暂停抱抱、转圈、鼓掌和赠礼，故事仍可阅读。</view>
      </view>
      <switch checked="{{group.interactionsPaused}}" bindchange="onPauseInteractions" />
    </view>
    <view wx:if="{{!isOwner}}" class="panel card">
      <view class="section-title">退出圈子</view>
      <button class="btn btn--ghost" data-retain="no" bindtap="onLeave">退出并移除此圈子的故事权限</button>
      <button class="btn btn--ghost" data-retain="yes" bindtap="onLeave">退出并保留圈内已发故事</button>
    </view>
  </block>
</view>
