.page {
  min-height: 100vh;
  padding: 20rpx 28rpx 220rpx;
  background:
    radial-gradient(100% 40% at 100% 0%, rgba(255, 176, 120, 0.16), rgba(242, 246, 255, 0) 60%),
    #f2f6ff;
}

.intro__title {
  font-size: 44rpx;
  font-weight: 800;
  letter-spacing: -0.5rpx;
}

.intro__sub {
  margin-top: 6rpx;
  font-size: 23rpx;
  color: #7a7790;
}

.preview {
  margin-top: 20rpx;
  padding: 22rpx 24rpx;
  display: flex;
  align-items: center;
  gap: 18rpx;
  background: linear-gradient(135deg, #ffffff, #f6f9ff);
}

.preview__avatar {
  width: 92rpx;
  height: 92rpx;
  border-radius: 50%;
  background: #eef4ff;
  overflow: hidden;
  flex: none;
}

.preview__main {
  flex: 1;
  min-width: 0;
}

.preview__name {
  font-size: 23rpx;
  color: #6b6784;
}

.preview__tags {
  margin-top: 10rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
}

.section {
  margin-top: 18rpx;
  padding: 26rpx;
}

.section__head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.chips {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.chips--grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.chips--grid .chip {
  flex: 0 0 calc(33.33% - 8rpx);
}

.chip {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  min-height: 64rpx;
  padding: 10rpx 22rpx;
  border-radius: 18rpx;
  background: #f5f7fc;
  border: 2rpx solid transparent;
  font-size: 24rpx;
  color: #4a4466;
  transition: all 120ms ease-out;
}

.chip--on {
  background: rgba(76, 141, 255, 0.1);
  border-color: #4c8dff;
  color: #2f6fe0;
  font-weight: 700;
}

.chip__emoji {
  font-size: 28rpx;
}

.input {
  height: 92rpx;
  padding: 0 22rpx;
  border-radius: 18rpx;
  background: #f5f7fc;
  font-size: 28rpx;
  color: #2b2340;
}

.placeholder {
  color: #b0adc2;
}

.presets {
  margin-top: 14rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.preset {
  font-size: 22rpx;
  color: #2f6fe0;
  background: rgba(76, 141, 255, 0.08);
  border-radius: 999rpx;
  padding: 8rpx 18rpx;
}

.textarea {
  width: 100%;
  min-height: 180rpx;
  padding: 20rpx 22rpx;
  border-radius: 18rpx;
  background: #f5f7fc;
  font-size: 27rpx;
  line-height: 1.65;
  color: #2b2340;
}

.warn {
  margin-top: 12rpx;
  padding: 14rpx 18rpx;
  border-radius: 14rpx;
  background: #fff3e0;
  color: #b25c0e;
  font-size: 22rpx;
  line-height: 1.6;
}

.hint {
  margin-top: 12rpx;
  font-size: 21rpx;
  color: #9a96ae;
  line-height: 1.6;
}

.groups {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.group-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 18rpx;
  border-radius: 18rpx;
  background: #f7f9ff;
}

.group-row--off {
  opacity: 0.42;
}

.self-hint {
  margin-top: 12rpx;
  font-size: 21rpx;
  color: #2f6fe0;
  line-height: 1.6;
}

.group-row__main {
  flex: 1;
}

.group-row__name {
  font-size: 26rpx;
  font-weight: 600;
}

.checkbox {
  width: 44rpx;
  height: 44rpx;
  border-radius: 14rpx;
  border: 2rpx solid #d7dcec;
  background: #fff;
  color: #fff;
  font-size: 26rpx;
  line-height: 40rpx;
  text-align: center;
  flex: none;
}

.checkbox--on {
  background: #4c8dff;
  border-color: #4c8dff;
}

.switch-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #f0f3fa;
}

.switch-row--last {
  border-bottom: none;
  padding-bottom: 4rpx;
}

.switch-row__name {
  font-size: 26rpx;
  font-weight: 600;
}

.switch-row switch {
  transform: scale(0.82);
  flex: none;
}

.tones {
  display: flex;
  gap: 8rpx;
  flex: none;
}

.tone {
  font-size: 21rpx;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: #f3f5fb;
  color: #6b6784;
}

.tone--on {
  background: rgba(76, 141, 255, 0.12);
  color: #2f6fe0;
  font-weight: 700;
}

.disclaimer {
  margin: 22rpx 10rpx 0;
  font-size: 21rpx;
  line-height: 1.6;
  color: #9a96ae;
  text-align: center;
}

.footer {
  position: fixed;
  display: flex;
  gap: 16rpx;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 16rpx 28rpx calc(16rpx + env(safe-area-inset-bottom));
  background: linear-gradient(180deg, rgba(242, 246, 255, 0), #f2f6ff 32%);
  z-index: 30;
}

.footer__btn {
  flex: 1;
  height: 92rpx;
  font-size: 30rpx;
}

.conflict {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
  font-size: 25rpx;
  line-height: 1.6;
}

.conflict__fields {
  padding: 12rpx 20rpx;
  border-radius: 18rpx;
  background: #f5f7fc;
}

.conflict__field {
  display: grid;
  grid-template-columns: 5em minmax(0, 1fr);
  gap: 12rpx;
  padding: 8rpx 0;
  white-space: pre-wrap;
  overflow-wrap: anywhere;
}

.conflict__label {
  font-weight: 600;
}

.conflict__actions {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}
